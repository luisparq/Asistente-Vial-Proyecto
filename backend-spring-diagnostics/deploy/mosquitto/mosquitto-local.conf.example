# Mosquitto 2.x - Configuración Local Segura para Windows (Laboratorio AVIGEM)
# Listener accesible desde la red local en el puerto MQTT estándar (1883)
listener 1883 0.0.0.0
protocol mqtt

# Autenticación obligatoria (rechaza clientes anónimos)
allow_anonymous false

# Archivos locales de autenticación y autorización
# En Windows, indicar la ruta absoluta o relativa con barras directas (/)
password_file ./passwd
acl_file ./avigem-local.acl

# Persistencia deshabilitada para pruebas de laboratorio
persistence false
