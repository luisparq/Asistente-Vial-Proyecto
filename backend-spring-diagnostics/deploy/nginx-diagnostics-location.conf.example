# Incluir dentro del bloque server HTTPS existente.
# Solo expone la ingesta autenticada; la interfaz y las consultas permanecen locales.
location ^~ /diagnostics-api/ {
    client_max_body_size 512k;
    limit_req zone=api burst=20 nodelay;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_pass http://127.0.0.1:8085/api/v1/diagnostics/real/;
}
