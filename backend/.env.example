APP_NAME="Asistente Vial API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=file
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_CA_FILE=

# Keep this server-side only. It is used by the traffic-tile proxy and is never exposed to browsers.
TOMTOM_TRAFFIC_KEY=
# Optional alternate Overpass endpoint when the default is unavailable.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Comma-separated fallback endpoints, only used when OVERPASS_URL cannot answer.
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
